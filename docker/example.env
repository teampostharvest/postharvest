# ============================================================================
# PostHarvest — docker compose environment template
# ============================================================================
# Copy this file to `docker/.env` and adjust values:
#
#     cp docker/example.env docker/.env
#
# This file drives docker compose ONLY. It lives in docker/ because that is
# compose's project directory (the .env auto-loaded for ${VAR:+default}
# interpolation and passed to services).
#
# There are NO real secrets in this file — placeholders only. Every variable
# already has a sane default baked into docker-compose.yml, so the stack runs
# without any .env; this template exists so you can override prod values with
# explicit secrets.
#
# The separate root .env.example is for the CLI / tests / local `next dev`
# (not compose). See THE README § Docker gotchas for the difference.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase Database (Session Pooler URI on port 5432 or direct connection)
# ---------------------------------------------------------------------------
SUPABASE_DB_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Firebase Authentication (Backend Admin SDK)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=postharvest-firebase
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Firebase Authentication (Frontend Client SDK — baked at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=postharvest-firebase.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=postharvest-firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=postharvest-firebase.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Fernet key used to encrypt user-uploaded Facebook cookies at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_ENCRYPTION_KEY=

# Comma-separated emails (case-insensitive) auto-promoted to the "ops" role on
# first login. Ops manage the shared cookie pool and user tiers in the UI.
# Example: OPS_EMAILS=you@example.com,admin@example.com
OPS_EMAILS=

# Max seconds a server-side personal Facebook login in Saved Sessions may take
# before it is abandoned and reported as failed.
PERSONAL_LOGIN_TIMEOUT_SECONDS=90.0

# ---------------------------------------------------------------------------
# Live session capture (dashboard "add session" flow)
# ---------------------------------------------------------------------------
# The backend launches a throwaway Chromium with a remote-debugging (CDP)
# endpoint bound to loopback INSIDE the container and returns a same-origin
# viewer link the user opens in a new tab to sign in to Facebook (solving any
# CAPTCHA live). The API proxies the DevTools frontend and bridges the
# websocket, so no CDP port is ever published — the flow works from any
# device behind the app's own origin (https/wss on the VPS).
SESSION_CAPTURE_PORT=9333
# Max seconds to wait for the user to finish logging in before cleanup.
SESSION_CAPTURE_TIMEOUT_SECONDS=240.0

# ---------------------------------------------------------------------------
# Runtime knobs (defaults already baked into docker-compose.yml)
# ---------------------------------------------------------------------------
# Backend concurrency / job caps.
WORKER_THREADS=4
MAX_URLS_PER_JOB=100
CANCEL_WAIT_SECONDS=5.0
# Redis job-state mirror + cancel coordination (service `redis` on the isolate
# network; empty = DB-only degraded mode).
REDIS_URL=redis://redis:6379/0
# scheduler / scraper compliance knobs (see COMPLIANCE.md).
SCRAPER_DELAY_SECONDS=2.5
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_RETRIES=3
SCRAPER_ROBOTS=1
# Browser origins allowed to call the API directly.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://postharvest.space"]
# Verbose logging toggle.
DEBUG=false

# ---------------------------------------------------------------------------
# Frontend (Next.js BUILD-TIME ONLY — inlined into the bundle on docker build)
# ---------------------------------------------------------------------------
# Base URL of the backend as seen FROM THE BROWSER. Keep empty for same-origin
# (nginx /api/* -> backend). If set, do NOT add /api — the frontend appends it.
NEXT_PUBLIC_API_URL=
# Public origin of THIS frontend for sitemap/robots/OG (prod).
NEXT_PUBLIC_SITE_URL=https://postharvest.space

# ---------------------------------------------------------------------------
# Prod resource caps (docker-compose.prod.yml layer only)
# ---------------------------------------------------------------------------
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1.5
FRONTEND_MEM_LIMIT=512m
FRONTEND_CPUS=1.0
NGINX_MEM_LIMIT=128m