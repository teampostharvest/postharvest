# ============================================================================
# PostHarvest — CLI / local dev / tests environment template
# ============================================================================
# Copy this file to `.env` for LOCAL CLI usage (outside Docker):
#
#     cp .env.example .env
#
# This file is for the CLI, the pytest suite, and local non-docker runs.
# It is NOT consumed by docker compose — compose reads docker/.env
# (template: docker/example.env). When you use the docker stack, ignore this
# file; compose supplies all backend vars from docker-compose.yml defaults.
#
# There are NO real secrets in this file — placeholders only.
# Backend env vars are read by pydantic-settings (backend/core/config.py from
# any .env file in the working directory). Scraper env vars are read directly
# from the environment by backend/scraper/fetcher.py.
# ============================================================================

# ---------------------------------------------------------------------------
# Application (optional overrides)
# ---------------------------------------------------------------------------
# DEBUG=true enables verbose logging.
DEBUG=false
# APP_NAME=PostHarvest API
# VERSION=1.0.0
# API_PREFIX=/api

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# PostgreSQL (default in docker-compose — both dev and prod).
# Compose sets this automatically from POSTGRES_USER/POSTGRES_PASSWORD; this
# line is for local CLI usage (outside Docker) or CI if you want to hit a real
# Postgres instance.
DATABASE_URL=postgresql+psycopg://postharvest:postharvest@localhost:5432/postharvest

# SQLite fallback — for local CLI usage without Docker, or for the test suite.
# For tests only: DATABASE_URL=sqlite:/:memory:

DATA_DIR=./data
# Where export files land: <EXPORT_BASE_DIR>/<job_id>/facebook_posts.{json,csv,xlsx}
EXPORT_BASE_DIR=./data/exports

# ---------------------------------------------------------------------------
# Worker / job manager
# ---------------------------------------------------------------------------
# Number of background scrape worker threads (parallel sources).
WORKER_THREADS=4
# Maximum URLs accepted per scrape request (sits above the Team plan's 150).
MAX_URLS_PER_JOB=300
# Seconds DELETE /api/jobs/{id} waits for an in-flight worker before deleting rows.
CANCEL_WAIT_SECONDS=5.0
# Per-source default post cap when the request does not specify max_posts.
DEFAULT_MAX_POSTS=
# Default post type filter: text | image | video | link | all
DEFAULT_POST_TYPE=all

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------
# JSON array of browser origins allowed to call the API directly.
# The frontend dashboard (http://localhost:3000) is allowed by default.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200

# ---------------------------------------------------------------------------
# Scraper — compliance knobs (lower = faster but less polite; see COMPLIANCE.md)
# ---------------------------------------------------------------------------
# Minimum delay between requests to facebook.com (seconds, floor 0.1).
# Default 2.5 s. Do NOT lower this in production use.
SCRAPER_DELAY_SECONDS=2.5
# Hard per-request timeout (seconds).
SCRAPER_TIMEOUT_SECONDS=20
# Max retries with exponential backoff on 429/5xx/transport/timeout (honors Retry-After).
SCRAPER_MAX_RETRIES=3
# 1 = enforce robots.txt, 0 = skip robots.txt checks (tests only; keep 1 in production).
SCRAPER_ROBOTS=1

# ---------------------------------------------------------------------------
# Firebase Authentication (Backend Admin SDK — server-side token verify)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=postharvest-firebase
FIREBASE_CLIENT_EMAIL=
# Private key with literal \n newlines, or set FIREBASE_CREDENTIALS_PATH to a
# service-account JSON file instead (file itself is gitignored).
FIREBASE_PRIVATE_KEY=
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json

# ---------------------------------------------------------------------------
# Supabase (managed Postgres — production database)
# ---------------------------------------------------------------------------
# SUPABASE_DB_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Secrets & access
# ---------------------------------------------------------------------------
# Fernet key for per-user Facebook cookie encryption (EMPTY = stored plaintext).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# COOKIE_ENCRYPTION_KEY=
# Comma-separated emails auto-promoted to the ops role on first login.
# OPS_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Frontend (Next.js — BUILD-TIME ONLY)
# ---------------------------------------------------------------------------
# Base URL of the backend API as seen FROM THE BROWSER. Inlined into the JS
# bundle during `next build` / `docker build`; changing it requires a rebuild.
# For local development: http://localhost:8000
# For production: https://postharvest.space  (the frontend appends /api itself;
#   do NOT add /api here — that would produce /api/api/... 404s).
# IMPORTANT: inside the docker stack these come from docker/.env (compose), not
# this file. They matter here only for running `next dev` directly on the host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase client SDK (mirrors docker/.env values; fallbacks in
# frontend/lib/firebase.ts apply when unset, but set them explicitly).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=postharvest-firebase.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=postharvest-firebase
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=postharvest-firebase.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Public origin of THIS frontend as seen by crawlers/search engines. Used for
# sitemap.xml, robots.txt and Open Graph canonical URLs (build-time only).
# For local development: http://localhost:3000
# For production: https://postharvest.space
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# node fetch seam (finalplanv2 §14)
# ---------------------------------------------------------------------------
# When true, the backend delegates HTTP-mode page fetches to the node
# service (:9334) instead of the built-in Python fetcher (parity phase).
USE_NODE=false
NODE_BASE_URL=http://127.0.0.1:9334
# When true, browser-mode scrapes run through node's Playwright capture
# (/fetch mode="browser") instead of the Python browser_scraper.
# Independent of USE_NODE; both stay OFF until §14 parity gates pass.
USE_NODE_BROWSER=false

# ---------------------------------------------------------------------------
# PostgreSQL (optional — only if running the CLI against the docker postgres
# or a host Postgres). Compose uses docker/.env for POSTGRES_* credential.
# ---------------------------------------------------------------------------
# POSTGRES_USER=postharvest
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=postharvest
