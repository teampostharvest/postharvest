{
  "name": "node",
  "version": "0.1.0",
  "private": true,
  "description": "PostHarvest fetcher — the only service that talks to Facebook (finalplanv2.md §4)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "playwright-core": "^1.63.0",
    "prom-client": "^15.1.3",
    "undici": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  }
}
