{
    "name": "postharvest-frontend",
    "version": "1.0.1",
    "private": true,
    "description": "Dashboard UI for the PostHarvest — public posts extraction with progress tracking, preview and JSON/CSV/Excel export.",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:ox": "oxlint .",
        "knip": "knip",
        "test": "vitest run",
        "test:watch": "vitest",
        "lighthouse": "lhci autorun",
        "lighthouse:collect": "lhci collect",
        "lighthouse:assert": "lhci assert --config-path=.lighthouserc.json"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "firebase": "^12.19.0",
        "framer-motion": "^13.2.0",
        "lucide-react": "^1.45.0",
        "motion-icons-react": "^1.1.0",
        "next": "^16.3.3",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwind-merge": "^2.5.4"
    },
    "devDependencies": {
        "@lhci/cli": "^0.15.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-config-next": "^16.3.3",
        "jsdom": "^30.0.1",
        "knip": "^6.35.1",
        "oxlint": "1.83.0",
        "postcss": "^8.4.49",
        "postcss-load-config": "^6.0.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.6.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    }
}
